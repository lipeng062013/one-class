# Copy this file to ".env" in the project root (or backend/.env), then fill values.
# Never commit real API keys.

# ---- Backend core ----
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
STORAGE_ROOT=./data/uploads

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_OPS_USERNAME=ops
SEED_OPS_PASSWORD=ops123
SEED_TEACHER_USERNAME=teacher1
SEED_TEACHER_PASSWORD=t123

# ---- LLM (文案大模型，OpenAI 兼容接口) ----
# 实际请求地址 = LLM_BASE_URL + /v1/chat/completions
# 例：官方 OpenAI 填 https://api.openai.com
# 例：国内中转站填 https://your-relay.example.com  （不要带末尾 /v1）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 图片生成（海报 AI，OpenAI 兼容 images 接口）----
# 实际请求地址 = IMAGE_API_BASE_URL + /v1/images/generations
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=/api/v1

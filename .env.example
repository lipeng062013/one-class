# 复制为项目根目录 .env 后填写（不要把真实 Key 提交到 Git）
#   Windows:  Copy-Item .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Docker 与本地开发共用此文件；compose 会覆盖 DATABASE_URL / STORAGE_ROOT 为容器内路径。

# ---- Backend core ----
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
STORAGE_ROOT=./data/uploads

# 演示账号（启动时 seed；生产请改密）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_OPS_USERNAME=ops
SEED_OPS_PASSWORD=ops123
SEED_TEACHER_USERNAME=teacher1
SEED_TEACHER_PASSWORD=t123

# ---- LLM（文案大模型，OpenAI 兼容接口）----
# 实际请求 = {LLM_BASE_URL}/v1/chat/completions
# 只填主机根，不要带 /v1/chat/completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 图片生成（海报 AI，OpenAI 兼容 images 接口）----
# 实际请求 = {IMAGE_API_BASE_URL}/v1/images/generations
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# ---- Frontend（仅 Vite 本地 dev 需要；Docker 构建已写死 /api/v1）----
VITE_API_BASE_URL=/api/v1

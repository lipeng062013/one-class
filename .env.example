# 复制为项目根目录 .env 后填写（不要把真实 Key 提交到 Git）
#   Windows:  Copy-Item .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Docker 与本地开发共用此文件；compose 会按 APP_DATA_DIR 覆盖容器内 DATABASE_URL / STORAGE_ROOT。
# 服务器：只在 /opt/one-class/.env 保留一份真实配置；自动部署不会覆盖本文件。
#
# ---- 测试数据 vs 生产数据 ----
# 两套数据物理隔离，目录都在项目 data/ 下（已 gitignore）：
#   data/dev/   ← 本地开发、联调（假线索/假学员）
#   data/prod/  ← 服务器正式业务
#
# 本机开发（推荐）：
#   APP_ENV=development
#   APP_DATA_DIR=dev
#   DATABASE_URL=sqlite:///./data/dev/app.db
#   STORAGE_ROOT=./data/dev/uploads
#
# 服务器生产：
#   APP_ENV=production
#   APP_DATA_DIR=prod
#   # Docker 会自动用 /app/data/prod/app.db 与 uploads，一般不必再写 DATABASE_URL
#   SEED_DEMO_DATA=false
#   并把 SEED_* 密码改成强密码

# ---- 环境 ----
# development | production
APP_ENV=development
# Docker 数据子目录名：dev 或 prod（与上面 APP_ENV 保持一致）
APP_DATA_DIR=dev

# ---- Backend core ----
# 本地 uvicorn 用相对路径；Docker 会覆盖为容器绝对路径
DATABASE_URL=sqlite:///./data/dev/app.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
STORAGE_ROOT=./data/dev/uploads
# local = 磁盘（开发默认）；oss = 素材/海报/学情附件写入阿里云 OSS（私有桶，经后端 API 预览）
STORAGE_BACKEND=local
# 是否灌演示线索/学员/额外老师。留空则：development 自动开，production 自动关
# SEED_DEMO_DATA=true

# 演示账号（启动时 seed；生产请改密）
# 注意：这里的 admin 是「网站登录账号」，不是 Linux SSH 用户
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_OPS_USERNAME=ops
SEED_OPS_PASSWORD=ops123
SEED_TEACHER_USERNAME=teacher1
SEED_TEACHER_PASSWORD=t123

# ---- LLM（文案大模型，OpenAI 兼容接口）----
# 实际请求 = {LLM_BASE_URL}/v1/chat/completions
# 只填主机根，不要带 /v1/chat/completions
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- 图片生成（海报 AI + 侧栏「GPT 生图」Playground，OpenAI 兼容）----
# 海报文生图：{IMAGE_API_BASE_URL}/v1/images/generations
# GPT Image Playground（参考图改图等）：经后端 /api/v1/image-playground/v1 代理到同一上游
# 只填主机根，不要带 /v1/images/generations
# tokenshop / aihub 等：IMAGE_API_BASE_URL=https://api.tokenshop.homes ，IMAGE_MODEL=gpt-image-2
# （不要用已失效的 imgapi.aihub.top；dall-e-3 仅适用于官方 OpenAI）
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# ---- Frontend（仅 Vite 本地 dev 需要；Docker 构建已写死 /api/v1）----
VITE_API_BASE_URL=/api/v1

# ---- 阿里云 OSS（备份 + 业务文件；桶请设为私有）----
# 控制台：对象存储 OSS → 创建 Bucket（地域建议与轻量同城，如华东2）
# Endpoint 示例（控制台「外网 Endpoint」，一般不带 https://）:
#   oss-cn-shanghai.aliyuncs.com
# AccessKey：建议用 RAM 子用户，只授该桶的读写权限
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 整包备份脚本用的前缀（scripts/backup/backup-to-oss.sh）
OSS_PREFIX=one-class/backups/
# 业务上传前缀：素材 / 海报 / 学情附件（STORAGE_BACKEND=oss 时生效）
OSS_UPLOAD_PREFIX=one-class/uploads/
# 备份是否包含 .env（1=是，包内文件名为 env.backup）。桶必须私有。
BACKUP_INCLUDE_ENV=1
